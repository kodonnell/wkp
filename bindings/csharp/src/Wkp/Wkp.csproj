<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Wkp</RootNamespace>
    <!-- Public API not listed in PublicAPI.*.txt (see below). -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>

    <PackageId>Wkp</PackageId>
    <!-- Kept in sync with the Cargo workspace version by scripts/check_versions.py. -->
    <Version>0.7.0</Version>
    <Authors>kodonnell</Authors>
    <Description>Well Known Polylines - fast and compact encoding of geometries to strings using the Google Polylines algorithm.</Description>
    <PackageTags>wkp;polyline;google-polyline;geometry;gis;geospatial;encoding</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kodonnell/wkp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kodonnell/wkp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    The public API is listed in PublicAPI.Shipped.txt (released) and PublicAPI.Unshipped.txt (since
    the last release); a change that is not listed there is a build error (RS0016/RS0017), so API
    changes are always deliberate. On release, move the Unshipped entries to Shipped.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
    <!--
      Native libraries built from bindings/c, one per RID, in runtimes/<rid>/native/. They are
      renamed from libwkp to libwkp_native (wkp_native.dll), because on Windows wkp.dll would
      collide with this assembly, Wkp.dll. CI downloads them for every RID and packs with
      -p:WkpSkipNativeBuild=true; local builds compile the current machine's one (below).
    -->
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes/" />
  </ItemGroup>

  <PropertyGroup>
    <WkpRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../'))</WkpRepoRoot>
    <WkpNativeFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">wkp.dll</WkpNativeFile>
    <WkpNativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libwkp.dylib</WkpNativeFile>
    <WkpNativeFile Condition="'$(WkpNativeFile)' == ''">libwkp.so</WkpNativeFile>
    <WkpPackedFile>$(WkpNativeFile.Replace('wkp', 'wkp_native'))</WkpPackedFile>
    <WkpCargoTargetDir Condition="'$(CARGO_TARGET_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(CARGO_TARGET_DIR)'))</WkpCargoTargetDir>
    <WkpCargoTargetDir Condition="'$(WkpCargoTargetDir)' == ''">$(WkpRepoRoot)target/</WkpCargoTargetDir>
  </PropertyGroup>

  <!-- Builds the C ABI library for this machine with cargo (requires Rust on PATH). -->
  <Target Name="WkpBuildNative" BeforeTargets="PrepareForBuild" Condition="'$(WkpSkipNativeBuild)' != 'true'">
    <Exec Command="cargo build --release -p wkp-capi" WorkingDirectory="$(WkpRepoRoot)" />
    <Copy SourceFiles="$(WkpCargoTargetDir)release/$(WkpNativeFile)"
          DestinationFiles="$(MSBuildThisFileDirectory)runtimes/$(NETCoreSdkRuntimeIdentifier)/native/$(WkpPackedFile)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <!-- Re-glob: the item above was evaluated before this target created the file. -->
      <None Remove="runtimes/**/*" />
      <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" CopyToOutputDirectory="PreserveNewest" LinkBase="runtimes/" />
    </ItemGroup>
  </Target>

</Project>
