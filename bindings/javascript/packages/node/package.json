{
  "name": "@wkpjs/node",
  "version": "0.6.1",
  "wkpCoreCompatibility": "0.6.0",
  "description": "Node.js bindings for WKP core via Node-API",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodonnell/wkp.git"
  },
  "homepage": "https://github.com/kodonnell/wkp",
  "bugs": {
    "url": "https://github.com/kodonnell/wkp/issues"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "prebuilds"
  ],
  "scripts": {
    "build": "node ./scripts/build-native.mjs",
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "benchmark": "node ./benchmark/benchmark.js",
    "test": "node --test ./tests/*.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
